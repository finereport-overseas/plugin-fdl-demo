<?xml version="1.0" encoding="UTF-8" standalone="no"?><plugin>
    <id>com.fr.plugin.dp.demo</id>
    <name><![CDATA[fdl插件demo]]></name>
    <active>yes</active>
    <version>1.0</version>
    <group>fdl</group>
    <env-version>4.1.0</env-version>
    <jartime>2023-08-10</jartime>
    <vendor>author</vendor>
    <description><![CDATA[这是一个fdl插件demo]]></description>
    <change-notes><![CDATA[
      [2020-06-02]初始化插件。<br/>
    ]]></change-notes>
    <main-package>com.fr.plugin.dp.demo</main-package>
    <prefer-packages>
        <prefer-package>com.fr.plugin.dp.demo</prefer-package>
    </prefer-packages>

    <!-- 生命周期钩子 -->
    <conditional-trigger class="com.fr.plugin.dp.demo.PluginConditionalTrigger"/>

    <!-- 主jar的接口，可以定义一些通用的功能扩展，如国际化 -->
    <extra-core>
        <LocaleFinder class="com.fr.plugin.dp.demo.resource.LocaleFinder"/>
    </extra-core>

    <!-- fdl插件特有的功能扩展 -->
    <extra-fdl>
<!--        <XxxProvider class="com.fr.plugin.dp.demo.Xxx"/>-->
    </extra-fdl>

    <!-- 插件功能记录点类 -->
    <function-recorder class="com.fr.plugin.dp.demo.resource.LocaleFinder"/>
</plugin>